# ========================================================
# Vector DB Selective - Backend Environment Configuration
# ========================================================

# --- Backend Server Settings ---
HOST=0.0.0.0
PORT=8000

# --- Vector Database Storage Settings ---
# Path to directory where isolated SQLite vector databases are stored
DATA_DIR=./data/databases

# --- Ollama Local LLM Engine Settings ---
# Base URL of your local or remote Ollama server instance
OLLAMA_BASE_URL=http://localhost:11434

# Default model to use for RAG Q&A synthesis if not specified by user
OLLAMA_DEFAULT_MODEL=llama3

# --- Document Chunking Settings ---
# Target chunk size in characters for text extraction
CHUNK_SIZE=600

# Overlap size in characters between adjacent chunks
CHUNK_OVERLAP=120


